# LLM Configuration (Qwen 3.5 Plus via DashScope)
OPENAI_API_KEY=your_dashscope_api_key_here
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen-plus
EMBEDDING_MODEL=text-embedding-v4

# LLM Backend: langchain (default) or openclaw
LLM_BACKEND=langchain
OPENCLAW_GATEWAY_URL=http://localhost:18789
OPENCLAW_GATEWAY_TOKEN=your_gateway_token_here
OPENCLAW_TIMEOUT=120
# Optional: only enable OpenClaw for specific agents (comma-separated)
# OPENCLAW_AGENTS=product,developer

# Vector Database (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=public_service_kb

# API Configuration
PORT=8000
DEBUG=True
